{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "ConnectionStrings": {
        "Redis": "localhost:6379"
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "HRM.backend": "Debug"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/system_log.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7,
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
    },
    "JwtSettings": {
        "SecretKey": "",
        "Issuer": "HRM.backend",
        "Audience": "UserClient",
        "AccessTokenExpirationMinutes": 60
    },
    "GoogleSettings": {
        "ClientId": "",
        "ClientSecret": ""
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:5173",
            "https://localhost:5173"
        ]
    },
    "ClientApp": {
        "BaseUrl": "https://localhost:5173"
    },
    "Auth": {
        "RefreshCookie": {
            "Secure": true,
            "SameSite": "Strict",
            "ExpirationDays": 7
        }
    },
    "PersonnelChange": {
        "Sla": {
            "ScanIntervalMinutes": 60,
            "SetStatusEscalated": true,
            "PendingHRReviewHours": 48,
            "PendingDirectorApprovalHours": 48,
            "PendingEmployeeConsentHours": 72,
            "PendingContractFlowHours": 72
        }
    },
     "EmailSettings": {
        "Host": "smtp.gmail.com",
        "Port": 587,
        "SenderName": "HICAS HRM System",
        "SenderEmail": "lidehap@gmail.com"        
    }
}
