# Copy this file to .env.docker and change the values before running Docker Compose.

MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=hrm_hicas
MYSQL_USER=hrm_user
MYSQL_PASSWORD=change-db-password

# Use a long random value in real deployments.
JWT_SECRET_KEY=change-this-development-jwt-secret-key-at-least-32-chars
JWT_ISSUER=HRM.backend
JWT_AUDIENCE=UserClient
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SENDER_NAME=HICAS HRM System
EMAIL_SENDER_EMAIL=
EMAIL_PASSWORD=

# Local Docker runs over HTTP through the frontend gateway.
# Set this to true only when the app is behind HTTPS.
AUTH_REFRESH_COOKIE_SECURE=false
